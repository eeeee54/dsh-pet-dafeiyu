assets/characters/*/frameseq/
assets/thumb/
assets/videos/
assets/animations/
assets/prompt/
assets/memes/

# ===== 运行时数据（含 API Key / 会话 / 日志，绝不入库） =====
data/
sessions/
usage.json
balance_cache.json

